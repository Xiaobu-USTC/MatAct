[
  {
    "name": "structure.search",
    "family": "structure",
    "cost": 1,
    "output": "candidate IDs and metadata",
    "typical_failure": "no match",
    "description": "Search the structure library by reduced formula, elements and/or prototype.",
    "parameters": {
      "type": "object",
      "properties": {
        "formula": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prototype": {
          "type": "string",
          "enum": [
            "fcc",
            "bcc",
            "diamond",
            "rocksalt",
            "zincblende",
            "cscl",
            "fluorite",
            "perovskite",
            "wurtzite"
          ]
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "structure.load",
    "family": "structure",
    "cost": 1,
    "output": "CIF/XYZ/POSCAR object",
    "typical_failure": "missing path",
    "description": "Parse a structure file in the workspace (CIF, POSCAR or extended XYZ).",
    "parameters": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "workspace:// URI"
        }
      },
      "required": [
        "uri"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "structure.validate",
    "family": "structure",
    "cost": 1,
    "output": "canonical structure + warnings",
    "typical_failure": "invalid geometry",
    "description": "Validate a parsed structure (interatomic distances, lattice, composition) and store a canonical copy under workspace://validated/.",
    "parameters": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "min_distance_A": {
          "type": "number"
        }
      },
      "required": [
        "uri"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "structure.convert",
    "family": "structure",
    "cost": 1,
    "output": "converted structure file",
    "typical_failure": "unsupported format",
    "description": "Write a parsed structure as CIF, POSCAR or XYZ, optionally as a supercell or with near-duplicate sites merged (merge_tol_A).",
    "parameters": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "format": {
          "type": "string",
          "enum": [
            "cif",
            "poscar",
            "xyz"
          ]
        },
        "supercell": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "merge_tol_A": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "format"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "dft.prepare",
    "family": "first_principles",
    "cost": 2,
    "output": "input directory",
    "typical_failure": "invalid parameter",
    "description": "Prepare a plane-wave DFT calculation for a validated structure. Metals need smearing.",
    "parameters": {
      "type": "object",
      "properties": {
        "structure_uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "code": {
          "type": "string"
        },
        "cutoff_eV": {
          "type": "number"
        },
        "k_mesh": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "relax": {
          "type": "boolean"
        },
        "smearing": {
          "type": "string",
          "enum": [
            "none",
            "gaussian",
            "mv"
          ]
        },
        "mixing_beta": {
          "type": "number"
        }
      },
      "required": [
        "structure_uri",
        "code",
        "cutoff_eV",
        "k_mesh",
        "relax"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "dft.run",
    "family": "first_principles",
    "cost": 8,
    "output": "status and output URI",
    "typical_failure": "timeout/non-convergence",
    "description": "Run a prepared DFT calculation; the run is killed when it exceeds max_cpu_hours.",
    "parameters": {
      "type": "object",
      "properties": {
        "input_uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "max_cpu_hours": {
          "type": "number"
        }
      },
      "required": [
        "input_uri",
        "max_cpu_hours"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "result.extract",
    "family": "first_principles",
    "cost": 2,
    "output": "scalar/vector properties",
    "typical_failure": "missing field",
    "description": "Extract properties from a finished DFT run.",
    "parameters": {
      "type": "object",
      "properties": {
        "output_uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "total_energy_eV",
              "energy_per_atom_eV",
              "lattice_a_A",
              "lattice_c_A",
              "band_gap_eV",
              "max_force_eV_A",
              "pressure_kbar",
              "converged"
            ]
          }
        }
      },
      "required": [
        "output_uri",
        "fields"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mlp.select",
    "family": "ml_potential",
    "cost": 2,
    "output": "model handle",
    "typical_failure": "incompatible cutoff",
    "description": "Select the cheapest registered ML interatomic potential that supports the elements and task within max_cost. Give elements or structure_uri.",
    "parameters": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": [
            "energy_forces",
            "relaxation",
            "md"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "structure_uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "max_cost": {
          "type": "number"
        }
      },
      "required": [
        "task",
        "max_cost"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mlp.train",
    "family": "ml_potential",
    "cost": 7,
    "output": "model artifact + logs",
    "typical_failure": "unstable training",
    "description": "Fine-tune a registered potential (or 'scratch') on a labelled dataset.",
    "parameters": {
      "type": "object",
      "properties": {
        "dataset_uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "base_model": {
          "type": "string"
        },
        "epochs": {
          "type": "integer"
        },
        "learning_rate": {
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "dataset_uri",
        "base_model",
        "epochs"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mlp.evaluate",
    "family": "ml_potential",
    "cost": 3,
    "output": "MAE/RMSE",
    "typical_failure": "shape mismatch",
    "description": "Evaluate an ML potential on a labelled test set (energy and force MAE).",
    "parameters": {
      "type": "object",
      "properties": {
        "model_uri": {
          "type": "string",
          "description": "workspace:// URI"
        },
        "test_uri": {
          "type": "string",
          "description": "workspace:// URI"
        }
      },
      "required": [
        "model_uri",
        "test_uri"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "database.query",
    "family": "database",
    "cost": 1,
    "output": "records and provenance",
