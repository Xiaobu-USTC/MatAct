          "type": "object"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "database",
        "filters"
      ],
      "additionalProperties": false
    }
  },
  {
